/*
 * Cards transforms adapted from Swiper 14.0.1, modules/effect-cards.mjs:
 * https://github.com/nolimits4web/swiper/blob/v14.0.1/src/modules/effect-cards/effect-cards.mjs
 * Default perSlideOffset = 8, perSlideRotate = 2. No Swiper DOM engine is used.
